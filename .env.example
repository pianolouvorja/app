# URL da API de catálogo (json_db) — primária. Em dev local, sobrescreva no
# .env.local (não versionado) para apontar para sua API/túnel.
VITE_URL_DATABASE=https://api.pianolouvorja.com.br/json_db

# Base de arquivos (covers, mídias) — mesma regra do .env.local para dev.
VITE_URL_FILES=https://api.pianolouvorja.com.br/file

# Base da API de coletâneas custom + login (v1/custom, auth). Usada por
# custom-catalog.ts e auth-client.ts. Sem ela, o front usa caminho relativo
# /v1/custom (depende de proxy em dev).
VITE_PALCO_API_URL=https://api.pianolouvorja.com.br

# Main process (Electron): download offline, fallback local:// e FTP params.
# Deve espelhar o mesmo host de VITE_PALCO_API_URL. Override p/ túnel/dev.
PIANO_API_BASE_URL=https://api.pianolouvorja.com.br

# Fallbacks em cascata (separados por vírgula) — usados quando a API primária
# cair (catálogo JSON). NÃO use LOUVORJA_FALLBACK_URLS — esse nome não é lido.
VITE_API_FALLBACK_URLS=https://api.louvorja.com.br,https://api.louvorja.workers.dev

# Token de acesso às rotas autenticadas da API. NUNCA commitar valor real —
# cada dev coloca o seu no .env.local.
VITE_API_TOKEN=
