pkgname=louvorja-piano
pkgdesc="LouvorJA PIANO — aplicativo desktop para gerenciamento de culto"
pkgver=1.17.6_beta.1
pkgrel=1
provides=("louvorja-piano")
replaces=()
conflicts=()
arch=('x86_64')
license=('MIT')
url="https://github.com/pianolouvorja/app"
depends=('gtk3' 'libnotify' 'libappindicator-gtk3' 'nss' 'libxss' 'libxtst' 'xdg-utils')
makedepends=('electron' 'npm' 'nodejs')

source=("${pkgname}-${pkgver}.tar.gz::https://github.com/pianolouvorja/app/archive/refs/tags/v${pkgver}.tar.gz")
md5sums=('SKIP')

# Diretório de build do Electron
_electron_version=$(electron --version | sed 's/v//')

case "${XBPS_TARGET_MACHINE}" in
    x86_64*) _arch="x64" ;;
    aarch64*) _arch="arm64" ;;
    i686*)    _arch="ia32" ;;
    armv7l*)  _arch="armv7l" ;;
    *)        _arch="x64" ;;
esac

build() {
    cd "${srcdir}/app-${pkgver}"
    npm install --production=false
    npm run build || npx electron-vite build
}

package() {
    cd "${srcdir}/app-${pkgver}"

    local appdir="${pkgdir}/opt/louvorja-piano"
    install -dm755 "${appdir}"
    cp -a dist-electron/linux-${_arch}-unpacked/* "${appdir}/"

    # Ícones
    for s in 16 24 32 48 64 128 256 512; do
        install -Dm644 build/icons/${s}x${s}.png "${pkgdir}/usr/share/icons/hicolor/${s}x${s}/apps/louvorja-piano.png"
    done

    # Desktop entry
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/louvorja-piano.desktop" << DESKTOP
[Desktop Entry]
Name=LouvorJA - PIANO
Comment=Aplicativo desktop para gerenciamento de culto
Exec=/opt/louvorja-piano/louvorja-piano --no-sandbox %U
Icon=louvorja-piano
Type=Application
Categories=AudioVideo;Audio;Player;
MimeType=x-scheme-handler/louvorja-piano;
StartupNotify=true
StartupWMClass=LouvorJA - PIANO
DESKTOP

    # Symlink no PATH
    install -dm755 "${pkgdir}/usr/bin"
    ln -sf /opt/louvorja-piano/louvorja-piano "${pkgdir}/usr/bin/louvorja-piano"

    # License
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
