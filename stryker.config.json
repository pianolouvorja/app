{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing config para pianolouvorja/app. Rodar: npx stryker run",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/plugins/i18n.ts",
    "src/modules/sync/services/library-catalog.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "timeoutMS": 30000,
  "concurrency": 2,
  "warnings": false
}
